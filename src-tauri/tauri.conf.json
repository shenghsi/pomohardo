{
  "productName": "Pomohardo",
  "version": "1.2.0",
  "identifier": "com.pomohardo",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run serve",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pomohardo",
        "width": 450,
        "height": 650,
        "resizable": false,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "app.desktop"
      },
      "rpm": {
        "desktopTemplate": "app.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/shenghsi/pomohardo/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0QzJFN0FGRTA3MkQ5OEIKUldTTDJYTGdyK2ZDUkwxbngrWURkUTl4ZjlzUG16ZmtFenV3UmdmVVdGM05OK1FnQzRLYmNyNDgK"
    }
  }
}
