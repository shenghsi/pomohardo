{
  "productName": "Pomohardo",
  "version": "0.9.6",
  "identifier": "com.pomohardo",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run serve",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pomohardo",
        "width": 450,
        "height": 650,
        "resizable": false,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "app.desktop"
      }
    },
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  },
  "plugins": {}
}
